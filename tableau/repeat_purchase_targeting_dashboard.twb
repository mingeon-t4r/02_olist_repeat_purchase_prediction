    <worksheet name='KPI - Multi-Item Repeat Rate'>
      <table>
        <view>
          <datasources>
            <datasource caption='Cutomer Repeat Base' name='federated.0bd34ui15f51jt169jo9j1njv08q' />
          </datasources>
          <datasource-dependencies datasource='federated.0bd34ui15f51jt169jo9j1njv08q'>
            <column caption='Repeat Rate' datatype='real' default-format='p0.00%' name='[Calculation_0718030640652290]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([repeat_90d_after_1h])&#13;&#10;/&#13;&#10;COUNTD([customer_unique_id])' />
            </column>
            <column caption='Basket Segment' datatype='string' name='[Calculation_0718030642630659]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([first_item_count]) THEN&#13;&#10;    &quot;Missing&quot;&#13;&#10;&#13;&#10;ELSEIF [first_item_count] &gt;= 2 THEN&#13;&#10;    &quot;Multi-Item&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;Single-Item&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Customer State' datatype='string' name='[customer_state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column caption='Customer Unique Id' datatype='string' name='[customer_unique_id]' role='dimension' type='nominal' />
