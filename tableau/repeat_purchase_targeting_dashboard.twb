            <column caption='Primary Payment Type' datatype='string' name='[primary_payment_type]' role='dimension' type='nominal' />
            <column caption='Repeat 90D After 1H' datatype='integer' name='[repeat_90d_after_1h]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0718030640652290]' derivation='User' name='[usr:Calculation_0718030640652290:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0bd34ui15f51jt169jo9j1njv08q].[none:Calculation_0718030642630659:nk]'>
            <groupfilter function='member' level='[none:Calculation_0718030642630659:nk]' member='&quot;Multi-Item&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0bd34ui15f51jt169jo9j1njv08q].[none:customer_state:nk]' filter-group='4'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:customer_state:nk]' member='&quot;AC&quot;' />
